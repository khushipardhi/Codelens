# =====================================================
# CodeLens — Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
#
# IMPORTANT: This app works fully offline without any
# API key. Add a key only if you want AI-powered mode.
# =====================================================

# ----------------------------
# Nvidia NIM — AI Provider
# ----------------------------
# Get your free key at: https://build.nvidia.com/
# Leave blank to use Offline mode only.
VITE_NVIDIA_API_KEY=

# Nvidia API base URL (do not change unless using a custom proxy)
VITE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model to use for analysis (default: fast 8B model)
# Other options: meta/llama-3.1-70b-instruct
VITE_NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ----------------------------
# Optional: Backend Proxy
# ----------------------------
# For production deployments, route AI requests through a
# backend proxy so your API key is never exposed in the bundle.
#
# VITE_API_PROXY_URL=https://your-backend.com/api/proxy
